{
  "name": "packet-tactics",
  "private": true,
  "type": "module",
  "scripts": {
    "export": "mkdir -p dist && godot --headless --path . --export-release Web dist/index.html",
    "export:web": "node -e \"require('node:fs').mkdirSync('dist',{recursive:true})\" && godot --headless --path . --export-release Web dist/index.html",
    "test:smoke": "godot --headless --path . --script res://test/pt_smoke_test.gd",
    "test:ui": "godot --headless --path . --script res://test/pt_ui_interaction_test.gd",
    "test:engine": "godot --headless --path . --script res://test/pt_engine_test.gd",
    "test": "godot --headless --editor --path . --import && npm run test:smoke && npm run test:ui && npm run test:engine"
  }
}

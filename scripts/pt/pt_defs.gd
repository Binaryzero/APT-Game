const AI_NAMES := ["CIPHER", "VECTOR", "PHANTOM", "DAEMON", "KERNEL", "ZERO"]

static func def(key: String) -> Dictionary:
	return DEFS[key]

## All deck keys expanded by copy count, in stable order.
static func deck_keys() -> Array:
	var keys: Array = []
	for key: String in DEFS:
		var copies := int(DEFS[key].get("copies", 0))
		for i in copies:
			keys.append(key)
	return keys

static func is_server_type(t: String) -> bool:
	return t == "prod" or t == "stage"

static func is_attach_type(t: String) -> bool:
	return t == "soft" or t == "mal"
